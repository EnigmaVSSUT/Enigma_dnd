# Copy to .env and adjust.
# POSTGRES_* initializes the local db service; DATABASE_URL connects the api.
# Keep the credentials in sync. NOTE: percent-encode special chars
# (@ : / % ? #) in the password, e.g. p@ss -> p%40ss.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dnd
POSTGRES_PORT=5432
PORT=3000
JWT_SECRET=replace-with-a-real-secret
DATABASE_URL=postgresql://app:changeme@db:5432/dnd?schema=public

# --- Hosted Postgres, e.g. Neon (swap with the local URL above to use) ---
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require&channel_binding=require
