# Copy to .env and adjust.
# Single source of truth: credentials live here once as POSTGRES_*.
# The api's DATABASE_URL is derived from these automatically
# (compose interpolation, entrypoint, scripts/with-db-url.cjs).
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dnd
POSTGRES_PORT=5432
PORT=3000
JWT_SECRET=replace-with-a-real-secret

# --- Hosted Postgres, e.g. Neon (full-URL override, takes precedence) ---
# NOTE: percent-encode special chars (@ : / % ? #) in the password,
# e.g. p@ss -> p%40ss.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require&channel_binding=require
