# --- AWS RDS (enigma-form) ---
# RDS is private (publiclyAccessible=false). From a laptop, open the SSM tunnel
# described in infra/README.md and run `PGHOST=localhost PGPORT=5433 npm run dev`.
# Variables already set in the shell win over this file.
PGHOST='enigma-form.clqsqi08ugyj.ap-south-1.rds.amazonaws.com'
PGPORT=5432
PGDATABASE='enigma_form'
PGUSER='enigma_admin'
# Master password lives in the Secrets Manager secret `enigma-form/db`.
# Fill it in without pasting it into your shell history:
#   read -rsp 'RDS password: ' PW && echo && sed -i "s|^PGPASSWORD=.*|PGPASSWORD='$PW'|" .env && unset PW
PGPASSWORD='CHANGE_ME'
# Prisma understands prefer|disable|require only; verify-full + sslrootcert is a
# libpq/psql option. `require` matches the deployed task definition.
PGSSLMODE='require'
PGCONNECT_TIMEOUT='20'
PGPOOL_TIMEOUT='30'

PORT=3000
JWT_SECRET=use-your-own-secret

# --- Local Postgres (docker compose db) -- commented out, see docker-compose.yml ---
# PGHOST='localhost'
# PGDATABASE='dnd'
# PGUSER='user'
# PGPORT=5433
# PGPASSWORD='password'
# PGCONNECT_TIMEOUT='20'
# PGPOOL_TIMEOUT='30'

# --- Full-URL override (takes precedence over the PG* parts above) ---
# DATABASE_URL=postgresql://user:password@host:5432/db?schema=public&sslmode=require

# --- Logging (pino, console only) ---
# LOG_LEVEL=debug  # trace|debug|info|warn|error|fatal (default: debug dev, info prod)
# SLOW_QUERY_THRESHOLD_MS=1000  # prisma queries slower than this log at warn
