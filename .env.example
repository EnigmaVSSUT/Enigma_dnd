# --- AWS RDS (enigma-form) ---
# Private instance: reach it through the SSM tunnel in infra/README.md.
# Variables already set in the shell win over this file.
PGHOST='enigma-form.clqsqi08ugyj.ap-south-1.rds.amazonaws.com'
PGPORT=5432
PGDATABASE='enigma_form'
PGUSER='enigma_admin'
# Password lives in the Secrets Manager secret `enigma-form/db`.
# Fill it in without putting it in your shell history:
#   read -rsp 'RDS password: ' PW && sed -i "s|^PGPASSWORD=.*|PGPASSWORD='$PW'|" .env
PGPASSWORD='CHANGE_ME'
PGSSLMODE='require'
PGCONNECT_TIMEOUT='20'
PGPOOL_TIMEOUT='30'

PORT=3000
JWT_SECRET=use-your-own-secret

# --- Local Postgres (docker compose --profile local-db up -d db) ---
# Use instead of the RDS values above; the image has no SSL.
# PGHOST='localhost'    # 'db' when the API itself runs in compose
# PGPORT=5433           # 5432 when the API runs in compose
# PGDATABASE='dnd'
# PGUSER='user'
# PGPASSWORD='password'
# PGSSLMODE='disable'

# --- Full-URL override (wins over the PG* parts above) ---
# DATABASE_URL=postgresql://user:password@host:5432/db?schema=public&sslmode=require

# --- Logging ---
# LOG_LEVEL=debug  # trace|debug|info|warn|error|fatal
# SLOW_QUERY_THRESHOLD_MS=1000
