# Copy to .env and adjust. The api builds its DATABASE_URL from these parts;
# set DATABASE_URL directly only to override them (e.g. a hosted database).
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dnd
POSTGRES_PORT=5432
PORT=3000
JWT_SECRET=replace-with-a-real-secret
# DATABASE_URL=postgresql://app:changeme@db:5432/dnd?schema=public

# --- Hosted Postgres (e.g. Neon) ---
# Either set the PG* parts (sslmode is required by Neon) or a full
# DATABASE_URL with ?sslmode=require. Either takes effect for both the
# app and `prisma migrate deploy`. When using Neon you can skip the
# local db service: `docker compose up api` (after commenting out depends_on).
# PGHOST=ep-rough-bird-a8903d8g-pooler.eastus2.azure.neon.tech
# PGDATABASE=Demo
# PGUSER=neondb_owner
# PGPASSWORD=npg_ZC4L0TbmEwzj
# PGSSLMODE=require
# PGCHANNELBINDING=require
