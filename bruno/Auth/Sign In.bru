meta {
  name: Sign In
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signin
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "userEmail": "{{userEmail}}",
    "userPassword": "{{userPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body) {
    if (res.body.token) {
      bru.setVar("token", res.body.token);
    }
    if (res.body.user && res.body.user.userId) {
      bru.setVar("userId", res.body.user.userId);
    }
    if (res.body.user && res.body.user.userName) {
      bru.setVar("userName", res.body.user.userName);
    }
  }
}

docs {
  ## POST /api/v1/auth/signin

  Authenticates a user and returns a JWT plus the user record.

  **Auth:** none

  ### Body fields

  | Field | Type | Rules |
  | --- | --- | --- |
  | `userEmail` | string | valid email |
  | `userPassword` | string | minimum 8 characters |

  The post-response script saves `token` and `userId` for the protected Forms requests.

  ### Sample request

  ```http
  POST {{baseUrl}}/api/v1/auth/signin
  Content-Type: application/json

  {
    "userEmail": "jane.doe@example.com",
    "userPassword": "Password123"
  }
  ```

  ### Sample response - 200

  ```json
  {
    "message": "Jane Doe signed in successfully",
    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
    "user": {
      "userId": "3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d",
      "userName": "Jane Doe",
      "userEmail": "jane.doe@example.com",
      "userAvtar": "https://example.com/avatars/jane-doe.png",
      "userRole": "admin"
    }
  }
  ```

  ### Errors

  | Status | Body |
  | --- | --- |
  | 400 | `{ "messsage": "Invalid input", "error": { ... } }` (note the extra `s` in `messsage`) |
  | 401 | `{ "message": "Incorrect password" }` |
  | 404 | `{ "message": "No user found try signing up" }` |
}

example {
  name: 200 - Signed in

  request: {
    url: {{baseUrl}}/api/v1/auth/signin
    method: POST
    mode: json

    headers: {
      Content-Type: application/json
    }

    body:json: {
      {
        "userEmail": "jane.doe@example.com",
        "userPassword": "Password123"
      }
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "message": "Jane Doe signed in successfully",
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyRW1haWwiOiJqYW5lLmRvZUBleGFtcGxlLmNvbSIsInVzZXJSb2xlIjoiYWRtaW4iLCJpYXQiOjE3NjE0NzAxMzIsImV4cCI6MTc2NDA2MjEzMn0.7mZ0h4oQ3Y8m2t0N5v1cRk9wS4pQ6xJ8aB3dE5fG7hI",
          "user": {
            "userId": "3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d",
            "userName": "Jane Doe",
            "userEmail": "jane.doe@example.com",
            "userAvtar": "https://example.com/avatars/jane-doe.png",
            "userRole": "admin"
          }
        }
      '''
    }
  }
}
