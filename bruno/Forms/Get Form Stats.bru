meta {
  name: Get Form Stats
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/form/stats/{{userId}}
  body: none
  auth: none
}

docs {
  ## GET /api/v1/form/stats/:userId

  Aggregates visits and submissions across all forms owned by a user.

  **Auth:** none

  ### Path parameters

  | Parameter | Type | Rules |
  | --- | --- | --- |
  | `userId` | string | UUID of an existing user |

  ### Sample request

  ```http
  GET {{baseUrl}}/api/v1/form/stats/3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d
  ```

  ### Sample response - 200

  ```json
  {
    "message": "Statistics fetched successfully",
    "data": {
      "visits": 42,
      "submissions": 12,
      "submissionRate": 28.571428571428573,
      "bounceRate": 71.42857142857143
    }
  }
  ```

  `submissionRate` is a percentage (`submissions / visits * 100`) and `bounceRate` is `100 - submissionRate`.

  ### Errors

  | Status | Body |
  | --- | --- |
  | 400 | `{ "message": "All fields are required !" }` |
  | 404 | `{ "message": "No users found !" }` |
}

example {
  name: 200 - Statistics fetched

  request: {
    url: {{baseUrl}}/api/v1/form/stats/{{userId}}
    method: GET
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "message": "Statistics fetched successfully",
          "data": {
            "visits": 42,
            "submissions": 12,
            "submissionRate": 28.571428571428573,
            "bounceRate": 71.42857142857143
          }
        }
      '''
    }
  }
}
