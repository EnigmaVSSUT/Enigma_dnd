meta {
  name: Get Form By Id
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/form/getform/{{userId}}/{{formId}}
  body: none
  auth: none
}

docs {
  ## GET /api/v1/form/getform/:userId/:formId

  Returns a single form owned by `userId`.

  **Auth:** none

  ### Path parameters

  | Parameter | Type | Rules |
  | --- | --- | --- |
  | `userId` | string | UUID of an existing user |
  | `formId` | string | UUID of an existing form owned by `userId` |

  ### Sample request

  ```http
  GET {{baseUrl}}/api/v1/form/getform/3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d/8f14e45f-ce3a-4f6f-9d3a-1b7c2d4e5f60
  ```

  ### Sample response - 200

  ```json
  {
    "message": "Employee Onboarding form fetched successfully",
    "form": {
      "id": "8f14e45f-ce3a-4f6f-9d3a-1b7c2d4e5f60",
      "userId": "3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d",
      "createdAt": "2026-10-26T09:15:32.481Z",
      "published": false,
      "name": "Employee Onboarding",
      "description": "Collect new hire details before day one",
      "content": "{}",
      "visits": 0,
      "submissions": 0,
      "shareUrl": "b6f3a1c9-7d2e-4a8b-9c0d-1e2f3a4b5c6d"
    }
  }
  ```

  ### Errors

  | Status | Body |
  | --- | --- |
  | 400 | `{ "message": "All fields are required" }` |
  | 404 | `{ "message": "NO users found" }` or `{ "message": "No form found" }` |
}

example {
  name: 200 - Form fetched

  request: {
    url: {{baseUrl}}/api/v1/form/getform/{{userId}}/{{formId}}
    method: GET
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "message": "Employee Onboarding form fetched successfully",
          "form": {
            "id": "8f14e45f-ce3a-4f6f-9d3a-1b7c2d4e5f60",
            "userId": "3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d",
            "createdAt": "2026-10-26T09:15:32.481Z",
            "published": false,
            "name": "Employee Onboarding",
            "description": "Collect new hire details before day one",
            "content": "{}",
            "visits": 0,
            "submissions": 0,
            "shareUrl": "b6f3a1c9-7d2e-4a8b-9c0d-1e2f3a4b5c6d"
          }
        }
      '''
    }
  }
}
