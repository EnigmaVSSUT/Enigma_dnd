meta {
  name: Get All Forms
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/form/all/{{userId}}
  body: none
  auth: none
}

docs {
  ## GET /api/v1/form/all/:userId

  Returns every form owned by a user, newest first.

  **Auth:** none

  ### Path parameters

  | Parameter | Type | Rules |
  | --- | --- | --- |
  | `userId` | string | UUID of an existing user |

  ### Sample request

  ```http
  GET {{baseUrl}}/api/v1/form/all/3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d
  ```

  ### Sample response - 200

  ```json
  {
    "message": "Forms fetched",
    "forms": [
      {
        "id": "8f14e45f-ce3a-4f6f-9d3a-1b7c2d4e5f60",
        "userId": "3d1f0a2b-9c4e-4f5a-8b6d-7e8f9a0b1c2d",
        "createdAt": "2026-10-26T09:15:32.481Z",
        "published": true,
        "name": "Employee Onboarding",
        "description": "Collect new hire details before day one",
        "content": "{\"components\":[]}",
        "visits": 42,
        "submissions": 12,
        "shareUrl": "b6f3a1c9-7d2e-4a8b-9c0d-1e2f3a4b5c6d"
      }
    ]
  }
  ```

  ### Errors

  | Status | Body |
  | --- | --- |
  | 400 | `{ "message": "Invalid input", "error": { ... } }` when `userId` is not a UUID |
  | 404 | `{ "message": "No forms found" }` |
}

example {
  name: 200 - Forms fetched

  request: {
    url: {{baseUrl}}/api/v1/form/all/{{userId}}
    method: GET
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
